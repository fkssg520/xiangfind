# 湘寻 · 环境变量示例
# 复制为 .env 后填写真实值。.env 已在 .gitignore 中，严禁提交。
# 校验配置是否完整：node scripts/mail-check.mjs（不带参数只查完整性）

# 服务端口
PORT=3000

# SQLite 数据库文件路径（相对项目根目录）
DATABASE_PATH=./data/xiangfind.db

# 会话密钥：用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成
# 留空会启动失败——这是故意的，避免用默认密钥上线
SESSION_SECRET=

# 邮件（QQ 邮箱示例：host smtp.qq.com / port 465 / 密码为授权码，不是 QQ 密码）
# 不配也能跑：验证码会打在服务端日志 [mail:dev] to=... code=123456
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# 发件人显示名
MAIL_FROM=湘寻 <you@qq.com>

# 对外访问地址：邮件里会带上这个链接，部署后改成真实域名
# 例：https://xiangfind.example.com（用 Cloudflare 隧道时填隧道地址）
PUBLIC_BASE_URL=http://localhost:3000

# 图片上传目录与单张上限（MB，默认 5）
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# 每小时允许注册的账号数（按 IP 计，防刷；默认 5）
REGISTER_LIMIT_PER_HOUR=5
