{
  "name": "xiangfind",
  "version": "0.1.0",
  "private": true,
  "description": "湘寻 · 湘潭大学校园失物招领平台（XiangFind）",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-isolation=none tests/unit",
    "test:watch": "node --test --watch --test-isolation=none tests/unit",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync.ps1"
  },
  "dependencies": {
    "nodemailer": "^7.0.0"
  }
}
